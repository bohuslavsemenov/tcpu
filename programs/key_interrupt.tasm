; --- Ternary Keyboard Interrupt Demo ---
; Sets up an interrupt handler to echo keypresses asynchronously.
; Exits when 'Q' (ASCII 81) is pressed.
; Stdout=9000, Stdin=9001, IVR=9003, IntStatus=9011

LDI 9003, R2
LDI INTERRUPT_HANDLER, R1
ST R1, R2           ; Set IVR = INTERRUPT_HANDLER

LDI 9000, R2        ; R2 = Stdout
LDI 9001, R3        ; R3 = Stdin
LDI 9011, R4        ; R4 = IntStatus

; Main Loop (Spinning doing nothing, wait for interrupts)
LOOP:
LDI LOOP, R0
JMP R0

; =====================================================================
; INTERRUPT HANDLER (IVR vector)
; =====================================================================
INTERRUPT_HANDLER:
LD R4, R8           ; Read IntStatus
LDI 2, R7           ; 2 = Keyboard Interrupt
CMP R8, R7
LDI DONE_INT, R8
JNE R8              ; If not keyboard interrupt, ignore and return

; Read keyboard character
LD R3, R5           ; Read character from Stdin (9001)

; Check if character is 'Q' (ASCII 81)
LDI 81, R7
CMP R5, R7
LDI EXIT, R7
JEQ R7

; Otherwise, Echo character to Stdout
ST R5, R2
LDI DONE_INT, R7
JMP R7

EXIT:
HALT

DONE_INT:
; Clear IntStatus to enable subsequent interrupts
LDI 0, R8
ST R8, R4
RTE
