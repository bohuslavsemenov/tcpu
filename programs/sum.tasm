; Sum of first N numbers program for Ternary CPU with Stdin/Stdout
; Calculates sum from 1 to N (N between 1 and 9)

; --- Setup Address Registers ---
LDI 9001, R1      ; Stdin
LDI 9000, R2      ; Stdout

; Print "Enter N (1-9): "
LDI 69, R0        ; 'E'
ST R0, R2
LDI 110, R0       ; 'n'
ST R0, R2
LDI 116, R0       ; 't'
ST R0, R2
LDI 101, R0       ; 'e'
ST R0, R2
LDI 114, R0       ; 'r'
ST R0, R2
LDI 32, R0        ; ' '
ST R0, R2
LDI 78, R0        ; 'N'
ST R0, R2
LDI 32, R0        ; ' '
ST R0, R2
LDI 40, R0        ; '('
ST R0, R2
LDI 49, R0        ; '1'
ST R0, R2
LDI 45, R0        ; '-'
ST R0, R2
LDI 57, R0        ; '9'
ST R0, R2
LDI 41, R0        ; ')'
ST R0, R2
LDI 58, R0        ; ':'
ST R0, R2
LDI 32, R0        ; ' '
ST R0, R2

; Read N
LD R1, R0

; Flush newline
LDI 10, R8
FLUSH_LOOP:
LD R1, R3
CMP R3, R8
LDI FLUSH_LOOP, R3
JNE R3

; Clamp input: default to 9 if out of bounds '1'-'9'
LDI 49, R8
CMP R0, R8
LDI USE_DEFAULT, R8
JGT R8

LDI 57, R8
CMP R0, R8
LDI USE_DEFAULT, R8
JLT R8

LDI -48, R8
ADD R8, R0        ; Convert N to integer (1-9)
LDI RUN_SUM, R8
JMP R8

USE_DEFAULT:
LDI 9, R0

RUN_SUM:
; R0 = N (Limit)
; R3 = Sum (starts at 0)
LDI 0, R3
; R4 = i (starts at 1)
LDI 1, R4
; R5 = constant 1 for increment
LDI 1, R5

SUM_LOOP:
ADD R4, R3        ; sum += i
CMP R4, R0        ; compare i with N
LDI PRINT_RESULT, R8
JEQ R8            ; if i == N, jump to printing
ADD R5, R4        ; i++
LDI SUM_LOOP, R8
JMP R8

PRINT_RESULT:
; Print "Result: "
LDI 82, R0        ; 'R'
ST R0, R2
LDI 101, R0       ; 'e'
ST R0, R2
LDI 115, R0       ; 's'
ST R0, R2
LDI 117, R0       ; 'u'
ST R0, R2
LDI 108, R0       ; 'l'
ST R0, R2
LDI 116, R0       ; 't'
ST R0, R2
LDI 58, R0        ; ':'
ST R0, R2
LDI 32, R0        ; ' '
ST R0, R2

; Print R3 as decimal (max 45)
LDI 10, R4        ; divisor
LDI 0, R0         ; tens count
TE_LOOP:
CMP R3, R4
LDI TE_DONE, R6
JGT R6
LDI -10, R6
ADD R6, R3
LDI 1, R6
ADD R6, R0
LDI TE_LOOP, R6
JMP R6
TE_DONE:
LDI 0, R6
CMP R0, R6
LDI PRINT_UNITS, R6
JEQ R6
LDI 48, R6
ADD R0, R6
ST R6, R2

PRINT_UNITS:
LDI 48, R6
ADD R3, R6
ST R6, R2

LDI 10, R0        ; newline
ST R0, R2

HALT
